# ---------- Pflicht ----------
# Öffentliche Adresse der App (Login, Abmelde-Links, Tracking).
APP_URL=https://coldmail.example.de
# Mind. 32 zufällige Zeichen. Verschlüsselt die Postfach-Passwörter – NICHT nachträglich ändern (sonst müssen alle Passwörter neu eingegeben werden).
# Erzeugen: openssl rand -base64 48
APP_SECRET=
# Erster Administrator (wird nur angelegt, solange es noch keinen Benutzer gibt).
ADMIN_EMAIL=admin@example.de
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# ---------- KI (Claude) ----------
# Empfohlen: Abrechnung über das Claude-Max-Abo (Nutzungslimits des Abos, keine Kosten pro Token).
# Token auf einem Rechner mit Browser erzeugen: `claude setup-token` (mit dem Max-Konto anmelden), Ergebnis hier eintragen.
# Der Token ist ca. ein Jahr gültig. In claude.ai unter Einstellungen → Nutzung „Zusatznutzung“ AUS lassen,
# dann kann nie mehr als das Abo verbraucht werden – bei erreichtem Limit pausiert die KI bis zum Reset.
CLAUDE_CODE_OAUTH_TOKEN=
# subscription (Max-Abo, Standard wenn Token gesetzt) | api (ANTHROPIC_API_KEY, Abrechnung pro Token)
AI_PROVIDER=subscription
# Nur für AI_PROVIDER=api. Bei AI_PROVIDER=subscription wird dieser Schlüssel NIE an Claude Code weitergegeben.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Max. Laufzeit einer KI-Anfrage (ms).
AI_TIMEOUT_MS=300000
# Pfad zum Claude-Code-Befehl (im Docker-Image vorinstalliert).
CLAUDE_BIN=claude
# Nur API-Modus: bei Ablehnung durch Sicherheitsfilter automatisch auf ein Ersatzmodell ausweichen.
AI_FALLBACKS=true

# ---------- Betrieb ----------
PORT=3000
DATA_DIR=/app/data
COOKIE_SECURE=true
# true hinter Coolify/Traefik, damit Rate-Limits die echte IP sehen.
TRUST_PROXY=true
DEFAULT_TIMEZONE=Europe/Berlin
# Eigene Tracking-Domain (CNAME auf diese App), z. B. https://link.musterfirma-mail.de – optional.
TRACKING_URL=
# Versand-Takt und IMAP-Abgleich (Millisekunden).
SCHEDULER_INTERVAL_MS=15000
SYNC_INTERVAL_MS=120000
# false = nur Oberfläche, kein Versand/Abgleich (z. B. für eine zweite Instanz).
WORKERS=true

# ---------- Google-Bewertungen (optional) ----------
# Google Places API (New) – Leadquellen prüfen Sterne und Anzahl der Google-Bewertungen.
# Google Cloud Console → APIs & Dienste → „Places API (New)“ aktivieren → Anmeldedaten → API-Schlüssel (auf Places API beschränken).
GOOGLE_PLACES_API_KEY=
